{
  "name": "dsh-pi-agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "基于 DeepSeek Harness 的自有 Agent 桌面产品（会话制 + 工件工作台）",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\" && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unused": "knip",
    "check:docs": "node scripts/ci/check-doc-budget.mjs && node scripts/ci/check-doc-duplicates.mjs",
    "check:diff": "node scripts/ci/check-diff-budget.mjs",
    "check:guard": "node scripts/ci/check-protected-tests.mjs && node scripts/ci/check-protected-paths.mjs",
    "check": "npm run check:docs && npm run typecheck && npm run lint && npm run unused && npm run test:registry && npm run test",
    "ci": "npm run check && npm run check:diff && npm run check:guard",
    "test:registry": "node scripts/ci/check-test-registry.mjs",
    "test:ci": "vitest run tests/"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "knip": "^5.41.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzgjj/dsh-pi-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xzgjj/dsh-pi-agent/issues"
  },
  "homepage": "https://github.com/xzgjj/dsh-pi-agent#readme"
}
